# Per-machine shell configuration for backup.sh and the profile helpers.
# Keep machine-specific labels and paths in the local copy of this file.

MACHINE_ID="${MACHINE_ID:-$(hostname -s)}"
SYNCTHING_ROOT="${SYNCTHING_ROOT:-$HOME/syncthing}"
BACKUP_ROOT="${BACKUP_ROOT:-$SYNCTHING_ROOT/backup/$MACHINE_ID}"
BACKUP_LOG="${BACKUP_LOG:-$HOME/.local/log/backup.log}"

# Additional roots for these tools are space-separated label:path entries.
# Paths in these three lists cannot contain whitespace.
CLAUDE_PROFILES="alternate:$HOME/.claude-alternate lab:$HOME/.claude-lab"
CODEX_PROFILES="alternate:$HOME/.codex-alternate lab:$HOME/.codex-lab"
OPENCODE_PROFILES="alternate:$HOME/.opencode-alternate lab:$HOME/.opencode-lab"

# DSH entries are newline-separated, so their absolute paths may contain spaces.
DSH_PROFILES="alternate:$HOME/.dsh-alternate
lab:$HOME/.dsh-lab"

# auto: include DSH_HOME only when DSH_PROFILES is empty.
DSH_INCLUDE_DEFAULT=auto
