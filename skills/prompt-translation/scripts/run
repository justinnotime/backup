#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd -P)
SKILL_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SKILL_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec "${PROMPT_TRANSLATION_PYTHON:-python3}" -B -m prompt_translation.scheduled "$@"
