{
  "schema_version": "agent-session-extraction-manifest/v1",
  "node_label": "node-example",
  "sources": [
    {
      "id": "claude-example",
      "enabled": true,
      "harness": "claude-code",
      "path": {"kind": "explicit", "value": "/absolute/source/claude/projects"},
      "authority": "owner",
      "required": true,
      "output_node": "node-example",
      "root_policy": {
        "allowed_lexical_roots": ["/absolute/source"],
        "allowed_resolved_roots": ["/absolute/source"],
        "forbidden_components": ["forbidden-profile"],
        "required_suffixes": ["/claude/projects"],
        "candidate_beneath_root": true,
        "symlinks": "confined"
      },
      "snapshot": "stable-bytes",
      "discovery": {"mode": "glob", "patterns": ["**/*.jsonl"]},
      "decoder": {},
      "allow_empty": false
    }
  ],
  "ownership": {"mode": "owner"},
  "event_policy": {
    "synthetic_prefixes": ["<synthetic-context>"],
    "peer_agent_prefixes": ["[peer from "],
    "peer_agent_exact": ["check messages"],
    "min_direct_user_events": 1,
    "min_user_chars": 1,
    "retain_conversational_subagents": false
  },
  "project_policy": {
    "mode": "all",
    "unknown": "keep",
    "allowlist": [],
    "denylist": [],
    "aliases": {}
  },
  "output": {
    "repository_root": "/absolute/output/repository",
    "history_directory": "SessionHistory",
    "prompt_directory": "SessionPrompts",
    "layout": "monthly",
    "migration": "none",
    "prompt_max_chars": 1500,
    "prompt_code_block_max_chars": 800,
    "encryption_attributes": {},
    "compatibility": {"rule_version": "none", "unchanged_sha256": []}
  },
  "transforms": {
    "redaction": {"required": true, "builtin_policy": "default", "patterns": []}
  },
  "cleanup": {"scope": "owner"},
  "indexes": {"mode": "none"},
  "publisher": {
    "strategy": "none",
    "owned_subtrees": ["SessionHistory", "SessionPrompts"],
    "encryption": "none",
    "key_link": null,
    "ciphertext_checkout": "refuse"
  },
  "gates": {
    "source_failure": "abort-required",
    "require_redaction_self_test": true,
    "require_output_audit": true,
    "require_reconciliation": true,
    "require_prepublication_scan": true
  }
}
